{
	"name": "@extws/adapter-redis",
	"version": "0.2.1-dev",
	"description": "Redis-based adapter for ExtWS servers",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "dist/esm/main.js",
	"types": "dist/esm/main.d.ts",
	"exports": {
		".": {
			"import": "./dist/esm/main.js",
			"require": "./dist/main.cjs"
		}
	},
	"dependencies": {
		"@extws/server": "github:extws-team/server#dev-kirick"
	},
	"peerDependencies": {
		"@kirick/ip": "^0.1.1",
		"redis": "^4.6.12"
	},
	"devDependencies": {
		"@kirick/eslint-config": "0.1.30",
		"@types/node": "^20.14.10",
		"eslint": "9.10.0",
		"neoevents": "0.2.0",
		"typescript": "5.5.4",
		"vitest": "2.1.1"
	},
	"scripts": {
		"build": "bun run build:ts && bun run build:cjs",
		"build:cjs": "bun build src/main.ts --outfile=dist/main.cjs --platform=node --format=cjs --packages=external",
		"build:ts": "rm -r dist/esm dist/types ; tsc",
		"check": "bun run lint && bun run build && bun run test",
		"lint": "eslint . && tsc --skipLibCheck --noemit",
		"redis:up": "docker ps | grep test-redis >/dev/null || docker run --rm -d -p 16379:6379 --name test-redis redis:7-alpine",
		"redis:down": "docker stop test-redis",
		"test": "bun run redis:up ; npm run test:vitest && bun test --coverage",
		"test:vitest": "vitest run --no-file-parallelism"
	},
	"engines": {
		"node": ">=16.13"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/extws-team/adapter-redis.git"
	},
	"keywords": [
		"websocket",
		"ws",
		"networking",
		"uwebsockets",
		"extws",
		"server",
		"adapter",
		"redis"
	],
	"author": "Daniil Kirichenko (https://twitter.com/kirickme)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/extws-team/adapter-redis/issues"
	},
	"homepage": "https://github.com/extws-team/adapter-redis#readme"
}
