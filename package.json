{
	"name": "@extws/adapter-redis",
	"version": "0.2.1-dev",
	"description": "Redis-based adapter for ExtWS servers",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"files": [
		"dist/"
	],
	"exports": {
		".": {
			"types": {
				"import": "./dist/main.d.mts",
				"require": "./dist/main.d.cts"
			},
			"import": "./dist/main.mjs",
			"require": "./dist/main.cjs"
		}
	},
	"engines": {
		"node": ">=21"
	},
	"peerDependencies": {
		"@extws/server": "github:extws-team/server#48f82f8e050b6d034de84ae579a3308cb47bacb3",
		"redis": "^4.6.12"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@kirick/ip": "^0.2.1",
		"@kirick/lint": "0.4.2",
		"@types/node": "^22",
		"eslint": "10.7.0",
		"neoevents": "0.3.1",
		"oxlint": "1.74.0",
		"publint": "0.3.24",
		"tsdown": "0.23.0",
		"typescript": "6.0.3",
		"unplugin-unused": "0.6.0",
		"vitest": "5.0.3"
	},
	"_devpack": {
		"@extws/server": "../server"
	},
	"scripts": {
		"build": "tsdown src/main.ts --clean --dts --format esm --format cjs --unused --publint",
		"check": "lint && bun run test && bun run build",
		"redis:up": "docker ps | grep test-redis >/dev/null || docker run --rm -d -p 16379:6379 --name test-redis redis:7-alpine",
		"test": "bun run redis:up ; bun test && npm run test:vitest",
		"test:vitest": "vitest run --no-file-parallelism"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/extws-team/adapter-redis.git"
	},
	"keywords": [
		"websocket",
		"ws",
		"networking",
		"uwebsockets",
		"extws",
		"server",
		"adapter",
		"redis"
	],
	"author": "Daniil Kirichenko (https://twitter.com/kirickme)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/extws-team/adapter-redis/issues"
	},
	"homepage": "https://github.com/extws-team/adapter-redis#readme"
}
