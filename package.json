{
	"name": "@extws/adapter-redis",
	"version": "0.2.1-dev",
	"description": "Redis-based adapter for ExtWS servers",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "dist/main.js",
	"types": "dist/main.d.ts",
	"exports": {
		".": {
			"types": {
				"import": "./dist/main.d.ts",
				"require": "./dist/main.d.cts"
			},
			"import": "./dist/main.js",
			"require": "./dist/main.cjs"
		}
	},
	"engines": {
		"node": ">=21"
	},
	"peerDependencies": {
		"@extws/server": "github:extws-team/server#ff4babb8f048976d66f1cb75510494bfccb5126a",
		"redis": "^4.6.12"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.1",
		"@kirick/ip": "^0.1.1",
		"@kirick/lint": "0.2.12",
		"@types/node": "^20",
		"eslint": "9.38.0",
		"neoevents": "0.2.0",
		"oxlint": "1.24.0",
		"publint": "0.3.15",
		"tsdown": "0.15.11",
		"typescript": "5.9.3",
		"unplugin-unused": "0.5.4",
		"vitest": "4.0.4"
	},
	"scripts": {
		"build": "tsdown src/main.ts --clean --tsconfig tsconfig.main.json --publint --unused --dts --format esm --format cjs",
		"check": "bun run lint && bun run build && bun run test",
		"lint": "biome format && oxlint && eslint . && tsc -b",
		"redis:up": "docker ps | grep test-redis >/dev/null || docker run --rm -d -p 16379:6379 --name test-redis redis:7-alpine",
		"redis:down": "docker stop test-redis",
		"test": "bun run redis:up ; npm run test:vitest && bun test --coverage",
		"test:vitest": "vitest run --no-file-parallelism"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/extws-team/adapter-redis.git"
	},
	"keywords": [
		"websocket",
		"ws",
		"networking",
		"uwebsockets",
		"extws",
		"server",
		"adapter",
		"redis"
	],
	"author": "Daniil Kirichenko (https://twitter.com/kirickme)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/extws-team/adapter-redis/issues"
	},
	"homepage": "https://github.com/extws-team/adapter-redis#readme"
}
